rules_version = '2';
// The Long Salvage battle log: only the listed players may read or write the log.
service cloud.firestore {
  match /databases/{database}/documents {
    function isPlayer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        // Write every address in lower case: the signed-in address is lower-cased before it is compared.
        && request.auth.token.email.lower() in [
          'player1@gmail.com',
          'player2@gmail.com'
        ];
    }
    // The log itself and the daily restore points.
    match /{collection}/{docId} {
      allow read, write: if isPlayer() && collection in ['gangs', 'battles', 'territories', 'restorepoints'];
    }
    // The log record: every player may read it. An entry can only be added under your own account, only its author may
    // extend it, and the account on it can't be changed afterwards. Any player may delete entries (old ones are tidied away).
    match /activity/{entryId} {
      allow read, delete: if isPlayer();
      allow create: if isPlayer() && request.resource.data.email == request.auth.token.email;
      allow update: if isPlayer() && resource.data.email == request.auth.token.email
        && request.resource.data.email == resource.data.email;
    }
  }
}
